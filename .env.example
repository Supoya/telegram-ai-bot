# ===== 必填 =====
# Telegram Bot Token： @BotFather 建机器人后发的那个
TELEGRAM_BOT_TOKEN=你的bot_token

# 唯一允许使用机器人的聊天ID（你的 Telegram 用户ID；机器人 DM 里你=这个ID）
OWNER_CHAT_ID=391640859

# 后端大脑（OpenCode-go，OpenAI 兼容）
OPENCODE_GO_API_KEY=你的opencode_go_key
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# 语音转文字（Gemini，转文字用）
GEMINI_API_KEY=你的gemini_key

# ===== 可选（都有默认值）=====
# OPENCODE_LLM_MODEL=deepseek-v4-flash-vision-exp
# GEMINI_MODEL=gemini-3.6-flash   # 注意：新账号必须用 3.x（旧 2.5-flash 已下线）
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE=+0%
# MAX_HISTORY=16
# REPLAY_MAX_TOKENS=350
# PROACTIVE_AS_VOICE=1      # 主动搭话发语音条
# PROACTIVE_MIN_DAY=1
# PROACTIVE_MAX_DAY=2
# TZ=Europe/Berlin          # 主动搭话按本地时间（在 Koyeb 里设）
